ATLAS_APP_ENV=development
ATLAS_APP_BASE_URL=http://127.0.0.1:4173
ATLAS_DATABASE_URL=sqlite:///./state/atlas.db
ATLAS_ALLOW_DEV_ENTITLEMENTS=true

# Configure all three values for production bearer-token verification.
ATLAS_OIDC_ISSUER=
ATLAS_OIDC_AUDIENCE=
ATLAS_OIDC_JWKS_URL=

# Stripe test-mode values. Keep secrets out of source control.
ATLAS_STRIPE_SECRET_KEY=
ATLAS_STRIPE_WEBHOOK_SECRET=
ATLAS_STRIPE_MONTHLY_PRICE_ID=
ATLAS_STRIPE_YEARLY_PRICE_ID=

ATLAS_DATA_RATE_LIMIT_REQUESTS=180
ATLAS_DATA_RATE_LIMIT_WINDOW_SECONDS=60
